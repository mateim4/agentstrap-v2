{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentStrap project config (.agentstrap/config.json)",
  "type": "object",
  "required": ["version", "continuity"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1, "description": "AgentStrap plugin version that wrote this config." },
    "existing_locations": {
      "type": "object",
      "description": "Tracks locations of structurally adopted components.",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "type", "count"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["file", "directory"] },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["planning", "code"] },
        "type": { "type": "string", "enum": ["web-app", "cli", "library", "docs", "other"] }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read by the SessionStart/Stop/SessionEnd hooks.",
      "required": ["vault_path", "handoff_file", "delta_file"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "vault_path": { "type": "string", "pattern": "^(?!.*\\.\\.\\/).*$", "minLength": 1, "description": "Absolute or project-relative path to the git repo holding the handoff (usually the docs vault or project root)." },
        "handoff_file": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.\\/).*$", "minLength": 1, "default": "HANDOFF.md", "description": "Path of HANDOFF.md relative to vault_path." },
        "delta_file": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.\\/).*$", "minLength": 1, "default": "DELTA_TRACKING.md", "description": "Path of DELTA_TRACKING.md relative to vault_path." },
        "push": { "type": "boolean", "default": true, "description": "If false, hooks write files but never git-push (rely entirely on an external committer)." },
        "obsidian_enabled": { "type": "boolean", "default": false, "description": "If true and Obsidian is running, the Stop hook leaves pushing to obsidian-git (single-writer rule); SessionEnd still guarantees a safe push." }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_files": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "field"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.\\/).*$", "minLength": 1 },
              "field": { "type": "string", "minLength": 1, "description": "JSON key, TOML key, or a regex tag identifying the version string." }
            }
          }
        },
        "build_command": { "type": "string", "maxLength": 1024 },
        "test_command": { "type": "string", "maxLength": 1024 },
        "artifact_dir": { "type": "string", "pattern": "^(?!\\/)(?!.*\\.\\.\\/).*$", "maxLength": 256 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_context": { "type": "string", "enum": ["air-gapped", "internal", "internet-facing"] }
      }
    }
  }
}

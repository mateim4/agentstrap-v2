{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/on-stop.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "agentstrap-antigravity": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash \"../scripts/session-start.sh\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash \"../scripts/on-stop.sh\""
      },
      {
        "type": "command",
        "command": "bash \"../scripts/session-end.sh\""
      }
    ]
  }
}
